# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/finance_ledger?schema=public

# API
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
DEV_USER_ID=1b58fb29-1f33-43d8-bdf0-b70844c20045

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Mobile
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# AI (OpenRouter)
# Text parsing, voice transcription, and receipt vision all use OpenRouter.
# Get a key at https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-1
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/Zack-y11/finances-led
OPENROUTER_APP_TITLE=Finance Ledger

# Temporary aliases (still accepted if OPENROUTER_* is empty):
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_TRANSCRIBE_MODEL=
# AI_MODEL=
